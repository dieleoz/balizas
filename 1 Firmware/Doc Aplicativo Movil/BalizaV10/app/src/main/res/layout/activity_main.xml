<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#ECEFF1"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="#FFFFFF">

                <!-- BANNER LOGO IT VIAL -->
                <ImageView
                    android:id="@+id/idImgLogoBanner"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginBottom="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_it_vial_banner" />

                <!-- TITULO Y VERSION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BALIZA VIAL 30"
                    android:textColor="#D32F2F"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Versión v2.9 · Control y Diagnóstico"
                    android:textColor="#546E7A"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginBottom="18dp" />

                <!-- CAMPO USUARIO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usuario:"
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/idEditTxName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_bg"
                    android:hint="Ingrese usuario (admin)"
                    android:textColor="#212121"
                    android:textColorHint="#90A4AE"
                    android:inputType="textPersonName"
                    android:text="admin"
                    android:textSize="15sp"
                    android:layout_marginBottom="14dp" />

                <!-- CAMPO CONTRASEÑA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contraseña:"
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/idEditTxtPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_bg"
                    android:hint="Ingrese contraseña (admin)"
                    android:textColor="#212121"
                    android:textColorHint="#90A4AE"
                    android:inputType="textPassword"
                    android:text="admin"
                    android:textSize="15sp"
                    android:layout_marginBottom="20dp" />

                <!-- BOTÓN ENTRAR (RESPONSIVE SIN TEXTO CORTADO) -->
                <Button
                    android:id="@+id/idBtEntrar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:text="ENTRAR AL SISTEMA"
                    android:textStyle="bold"
                    app:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Credenciales de técnico: admin / admin"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>