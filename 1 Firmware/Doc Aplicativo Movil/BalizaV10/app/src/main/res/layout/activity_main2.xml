<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/idMainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".MainActivity2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- CONSOLA DE VOLCADO Y ESTADO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consola de Datos Baliza v2.4"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <ScrollView
                    android:id="@+id/idScrollViewOut"
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <TextView
                        android:id="@+id/idTxtViewOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Seleccione un dispositivo Bluetooth y presione LEER..."
                        android:textColor="#00FF66"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PANEL DE ACCIONES / BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/idBtnDispositivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/sDispositivo"
                android:textSize="12sp"
                app:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/idBtnLeer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/sLeer"
                android:textSize="12sp"
                app:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/idBtnConf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/sConfig"
                android:textSize="12sp"
                app:backgroundTint="#388E3C"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- TARJETA DE PROGRAMACIÓN DE ALARMA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuración de Franja Horaria"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- FILA ALARMA Y SWITCH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/idTxtNoAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sNoAlarma"
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/idSpNoAlarm"
                        android:layout_width="80dp"
                        android:layout_height="40dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Switch
                        android:id="@+id/idSwEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sEnable"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- FILA HORA INICIO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sAlarmaInit"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/idSpHourInit"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/idSpMinInit"
                        android:layout_width="80dp"
                        android:layout_height="40dp" />
                </LinearLayout>

                <!-- FILA HORA FIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sAlarmaEnd"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/idSpHourEnd"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/idSpMinEnd"
                        android:layout_width="80dp"
                        android:layout_height="40dp" />
                </LinearLayout>

                <!-- FILA HORARIO / DIAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sHorario"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/idSpHorario"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>