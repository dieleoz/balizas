<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/idMainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F5F9"
    tools:context=".MainActivity2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. CONSOLA DE VOLCADO Y TERMINAL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consola de Telemetría IT VIAL 30 (v3.4)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <ScrollView
                    android:id="@+id/idScrollViewOut"
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <TextView
                        android:id="@+id/idTxtViewOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Conecte el dispositivo Bluetooth y presione LEER..."
                        android:textColor="#22C55E"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. PANEL DE ACCIONES PRINCIPALES (BOTONES RESPONSIVOS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/idBtnDispositivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:minHeight="48dp"
                android:layout_marginEnd="4dp"
                android:text="@string/sDispositivo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:backgroundTint="#DC2626"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/idBtnLeer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/sLeer"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/idBtnConf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginStart="4dp"
                android:text="@string/sConfig"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 3. IDENTIFICADOR Y NOMBRE DE LA BALIZA (OTA) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE / UBICACIÓN DE LA SEÑAL"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/idEdtNombreBaliza"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#F8FAFC"
                        android:hint="Ej: Col. San José - Km 4+200"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="12sp"
                        android:textColor="#0F172A" />

                    <Button
                        android:id="@+id/idBtnGuardarNombre"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_marginStart="6dp"
                        android:text="GUARDAR"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2563EB"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

                <!-- CARD DE AUTODIAGNÓSTICO EXPERTO Y SOLUCIÓN INMEDIATA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/idCardAutoDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/idTxtIconoDictamen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢"
                        android:textSize="16sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/idTxtTituloDictamen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DICTAMEN TÉCNICO INMEDIATO"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/idTxtMensajeDictamen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Presione LEER para ejecutar el autodiagnóstico integral del sistema."
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/idTxtAccionRecomendada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F8FAFC"
                    android:padding="8dp"
                    android:text="👉 Acción requerida: Ninguna. El equipo está listo para operar."
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. DIAGNÓSTICO ENERGÉTICO Y AUDITORÍA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DIAGNÓSTICO ENERGÉTICO Y SALUD"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Batería 12V / Panel:"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/idTxtVoltaje"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.- V"
                            android:textColor="#10B981"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/idTxtEstadoBat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presione LEER para medir"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cortes de Energía:"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/idTxtCortes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- cortes"
                            android:textColor="#3B82F6"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/idTxtSalud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Memoria EEPROM OK"
                            android:textColor="#10B981"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/idBtnExportAudit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="📤 COMPARTIR CERTIFICADO DE AUDITORÍA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4F46E5"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

                <!-- CHECKLIST DE MANTENIMIENTO Y AUDITORÍA EN CAMPO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHECKLIST DE MANTENIMIENTO PREVENTIVO"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <CheckBox
                    android:id="@+id/idChkPanelSolar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Panel solar limpio y fusible 12V verificado"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/idChkPilaRTC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Pila de botón CR2032 (3V) verificada / OK"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/idChkBorneras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Borneras ajustadas (sin falsos contactos)"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/idChkTestLuz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Prueba de destello de luz (Test 2 min) ejecutada"
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. ACCESO RÁPIDO: HORARIO ESCOLAR OFICIAL (1-TOQUE) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN RÁPIDA (NORMA VIAL)"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programa en 1 toque las 3 franjas escolares oficiales:\n• 06:00 - 09:00  |  • 11:30 - 13:30  |  • 15:00 - 16:30 (L-V)"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/idBtnHorarioEscolar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="⚡ Programar Horario Escolar (1 Toque)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1E40AF"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. PROGRAMACIÓN MANUAL DETALLADA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROGRAMACIÓN MANUAL DE FRANJA"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Selector de Alarma y Switch ON/OFF -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alarma:"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <Spinner
                        android:id="@+id/idSpNoAlarm"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpNoAlarm" />

                    <Switch
                        android:id="@+id/idSwEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ON/OFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Hora Inicio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Inicio:"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/idSpHourInit"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpHour" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textStyle="bold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                    <Spinner
                        android:id="@+id/idSpMinInit"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpMin" />
                </LinearLayout>

                <!-- Hora Fin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Fin:"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/idSpHourEnd"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpHour" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textStyle="bold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                    <Spinner
                        android:id="@+id/idSpMinEnd"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpMin" />
                </LinearLayout>

                <!-- Días de Activación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="Días:"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/idSpHorario"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:entries="@array/aSpHorario" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 7. MANDO DIRECTO Y PRUEBA DE FOCO EN CAMPO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PRUEBA FÍSICA DE FOCO (MANDO DIRECTO)"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activa el destello ámbar a 1.0 Hz para verificar los LEDs y la etapa de potencia:"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/idBtnTestLuz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="46dp"
                        android:layout_marginEnd="4dp"
                        android:text="💡 Activar Test (2 min)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#D97706"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/idBtnStopTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="46dp"
                        android:layout_marginStart="4dp"
                        android:text="⏹️ Apagar Test"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#475569"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>